module PINFILTER (
  clk_54m,
  js_clk_d,
  bus_clk_3m6
)
;
input clk_54m;
input js_clk_d;
output bus_clk_3m6;
wire n22_3;
wire n7_5;
wire [1:0] dpipe;
wire VCC;
wire GND;
  LUT2 n22_s0 (
    .F(n22_3),
    .I0(dpipe[0]),
    .I1(dpipe[1]) 
);
defparam n22_s0.INIT=4'h9;
  LUT2 n7_s2 (
    .F(n7_5),
    .I0(dpipe[0]),
    .I1(dpipe[1]) 
);
defparam n7_s2.INIT=4'h1;
  DFF n8_s0 (
    .Q(dpipe[1]),
    .D(dpipe[0]),
    .CLK(clk_54m) 
);
  DFF n9_s0 (
    .Q(dpipe[0]),
    .D(js_clk_d),
    .CLK(clk_54m) 
);
  DFFR n7_s0 (
    .Q(bus_clk_3m6),
    .D(n22_3),
    .CLK(clk_54m),
    .RESET(n7_5) 
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* PINFILTER */
